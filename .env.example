# Корневой URL проекта: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Только серверный ключ. Никогда не публикуйте его и не используйте NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Замените длинной случайной строкой (минимум 32 символа).
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long

# Часовой пояс склада (IANA). Используется для границ отчетных дней.
WAREHOUSE_TIMEZONE=Europe/Moscow
